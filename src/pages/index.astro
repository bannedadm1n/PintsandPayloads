---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout description="Red teaming, social engineering, offensive security and the odd rambling over a pint.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">// CYBER_SECURITY_LOG :: ONLINE</div>
        <h1><span class="chev">&gt;</span> PINTS &amp;<br /><span>PAYLOADS_</span></h1>
        <p class="hero-tagline">Real stories. Real offsec. <strong>No buzzwords.</strong></p>
        <p class="lede">Red team tradecraft, social engineering, physical security, technical rabbit holes and the occasional questionable idea — written like security people actually talk.</p>
        <a class="button" href="#latest">&gt; VIEW LATEST POSTS</a>
      </div>

      <div class="terminal-shell">
        <div class="terminal-top">
          <span></span><span></span><span></span>
          <div>bash — pintsandpayloads</div>
        </div>
        <pre><code><span class="green">$</span> whoami
red_team_operator

<span class="green">$</span> cat /etc/motd
"Keep it simple.
 Make it interesting."

<span class="green">$</span> drink
pint --payload<span class="blink">█</span></code></pre>
      </div>
    </div>
    <div class="hero-status wrap">
      <span>&gt; tail -f /var/log/ramblings.log</span>
      <span class="status-online">● LIVE</span>
    </div>
  </section>

  <section id="latest" class="section wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow">// LATEST_FROM_THE_BLOG</div>
        <h2>Recent transmissions</h2>
      </div>
      <span class="count">{String(posts.length).padStart(2,'0')} ENTRIES</span>
    </div>

    <div class="posts">
      {posts.map((post, index) => (
        <a class:list={["post", index === 0 && "featured"]} href={`/posts/${post.id}/`}>
          <div class="post-corners" aria-hidden="true"></div>
          <div class="post-meta">
            <span>_{post.data.category.replaceAll(' ', '_').toUpperCase()}</span>
            <span>{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}</span>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="read">READ MORE <span>→</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="manifesto">
    <div class="wrap manifesto-grid">
      <div>
        <div class="eyebrow">// ABOUT_THIS_NODE</div>
        <h2>No conference voice.<br /><span>No vendor fluff.</span></h2>
      </div>
      <div class="manifesto-copy">
        <p>Pints &amp; Payloads is where I dump the interesting bits: offensive security, physical assessments, social engineering, Active Directory, cloud and whatever rabbit hole I fell into that week.</p>
        <p class="command">$ printf "stay curious. break responsibly.\n"</p>
      </div>
    </div>
  </section>
</Layout>
