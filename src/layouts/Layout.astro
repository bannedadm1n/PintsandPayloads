---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Pints & Payloads', description = 'Simple conversations about security.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} — Pints & Payloads</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">
          <span class="brand-mark">P&P</span>
          <span>Pints <b>&</b> Payloads</span>
        </a>
        <nav>
          <a href="/#latest">Latest</a>
          <a href="/about">About</a>
          <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap footer-inner">
        <div>
          <div class="footer-brand">Pints & Payloads</div>
          <p>Cyber security, red teaming, social engineering and the occasional bad idea.</p>
        </div>
        <div class="footer-right">© {new Date().getFullYear()} Pints & Payloads</div>
      </div>
    </footer>
  </body>
</html>