---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Pints & Payloads', description = 'Real stories. Real offsec. No buzzwords.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050607" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} — Pints & Payloads</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/">
          <span class="prompt">root@pintsandpayloads:~$</span>
          <span class="brand-name">PINTS &amp; PAYLOADS<span class="cursor">_</span></span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/">[_HOME]</a>
          <a href="/#latest">[_BLOG]</a>
          <a href="/about">[_ABOUT]</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap footer-inner">
        <div>
          <div class="footer-brand">PINTS &amp; PAYLOADS_</div>
          <p>Real stories. Real offsec. No buzzwords.</p>
        </div>
        <div class="footer-right">// {new Date().getFullYear()} · EOF</div>
      </div>
    </footer>
  </body>
</html>
